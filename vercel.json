{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/og.js": {
      "includeFiles": "node_modules/**/*.wasm",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/plan/:code",
      "destination": "/api/plan-page?code=:code"
    }
  ]
}
