{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/og.js": {
      "includeFiles": "node_modules/**/*.wasm",
      "memory": 1024,
      "maxDuration": 15
    },
    "api/pages.js": {
      "includeFiles": "data/**",
      "maxDuration": 60
    },
    "api/guide-check.js": {
      "includeFiles": "data/**",
      "maxDuration": 60
    },
    "api/plan-ics.js": {
      "includeFiles": "data/**",
      "maxDuration": 15
    },
    "api/tm-link.js": {
      "includeFiles": "data/**",
      "maxDuration": 15
    },
    "api/schedule.js": {
      "includeFiles": "data/**",
      "maxDuration": 60
    },
    "api/broadway2.js": {
      "includeFiles": "data/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/plan/:code/calendar.ics",
      "destination": "/api/plan-ics?code=:code"
    },
    {
      "source": "/plan/:code",
      "destination": "/api/plan-page?code=:code"
    },
    {
      "source": "/london",
      "destination": "/api/pages?type=city&city=london"
    },
    {
      "source": "/london/",
      "destination": "/api/pages?type=city&city=london"
    },
    {
      "source": "/london/matinees",
      "destination": "/api/pages?type=matinees&city=london"
    },
    {
      "source": "/london/matinees/",
      "destination": "/api/pages?type=matinees&city=london"
    },
    {
      "source": "/london/:slug",
      "destination": "/api/pages?type=show&city=london&slug=:slug"
    },
    {
      "source": "/london/:slug/",
      "destination": "/api/pages?type=show&city=london&slug=:slug"
    },
    {
      "source": "/new-york",
      "destination": "/api/pages?type=city&city=new-york"
    },
    {
      "source": "/new-york/",
      "destination": "/api/pages?type=city&city=new-york"
    },
    {
      "source": "/new-york/matinees",
      "destination": "/api/pages?type=matinees&city=new-york"
    },
    {
      "source": "/new-york/matinees/",
      "destination": "/api/pages?type=matinees&city=new-york"
    },
    {
      "source": "/new-york/:slug",
      "destination": "/api/pages?type=show&city=new-york&slug=:slug"
    },
    {
      "source": "/new-york/:slug/",
      "destination": "/api/pages?type=show&city=new-york&slug=:slug"
    },
    {
      "source": "/guides",
      "destination": "/api/pages?type=guide"
    },
    {
      "source": "/guides/",
      "destination": "/api/pages?type=guide"
    },
    {
      "source": "/guides/:slug",
      "destination": "/api/pages?type=guide&slug=:slug"
    },
    {
      "source": "/guides/:slug/",
      "destination": "/api/pages?type=guide&slug=:slug"
    },
    {
      "source": "/about",
      "destination": "/api/pages?type=about"
    },
    {
      "source": "/about/",
      "destination": "/api/pages?type=about"
    }
  ],
  "crons": [
    {
      "path": "/api/guide-check",
      "schedule": "0 5 * * 1"
    }
  ]
}
